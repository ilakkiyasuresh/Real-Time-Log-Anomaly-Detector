
# Copy to backend/.env and fill in. Never commit the real .env.
AWS_ENABLED=0                      # 1 = real AWS, 0 = mock mode (prints instead of sending)
AWS_REGION=ap-south-1
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:log-anomaly-alerts
CW_LOG_GROUP=/hackathon/log-anomaly-detector
CW_LOG_STREAM=alerts
CW_METRIC_NAMESPACE=LogAnomalyDetector

# Pipeline tuning (demo defaults shown; for fast dev use 20 / 2 / 10)
LOG_PATH=../generator/logs/app.log
WINDOW_S=60
TICK_S=5
WARMUP_TICKS=12
GENERATOR_URL=http://localhost:8099
